<Project>
	<!--
		Shipped inside the Purview.Unions package as buildTransitive/** (project
		Sdk/buildTransitive/Purview.Unions.props maps to the package root), so PackageReference consumers
		receive the compiler-visible property the bundled source generator reads. Without it,
		$(DisableUnionsSourceGenerator) would never reach the generator and the documented switch would
		silently do nothing outside this repository.

		The framework's PSGF0003 validation checks that every property declared as generator-read
		(PurviewGeneratorVisibleProperty) is either a CompilerVisibleProperty in the build or declared by
		a package's own Sdk/build* assets, which keeps this file and the generator in sync.
	-->
	<ItemGroup Label="Compiler Visible Generator Properties">
		<CompilerVisibleProperty Include="DisableUnionsSourceGenerator">
			<Description>True to disable union generation while still emitting the internal .NET 10 attribute polyfills when they are needed.</Description>
		</CompilerVisibleProperty>
	</ItemGroup>
</Project>
