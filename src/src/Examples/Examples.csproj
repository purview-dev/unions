<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<Title>Purview Unions Examples</Title>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Unions\Unions.csproj" />
		<!--
			Runs the generator on this sample. A ProjectReference to the runtime package does not flow the
			analyzer transitively, so the sample references the generator explicitly, exactly as a
			consumer would receive it from the packed package.
		-->
		<ProjectReference
			Include="..\SourceGenerator\SourceGenerator.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>
</Project>
